# Cliente: httpYac - Rest Client (anweber.vscode-httpyac).
# Cada turno 2 usa @ref y el JSON del turno 1; no requiere copiar el UUID.
# Tras reiniciar el backend, ejecutar de nuevo turno 1 o Reset de httpYac.

﻿POST http://localhost:3000/chat
Content-Type: application/json

{
    "message": "Hola servidor"
}

